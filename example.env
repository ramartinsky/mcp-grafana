GRAFANA_URL=https://hyperion.at.sky/
GRAFANA_AUTH_MODE=sso
GRAFANA_LOGIN_PATH=/login/azuread
GRAFANA_SSO_HOSTS=login.microsoftonline.com
GRAFANA_SSO_TIMEOUT=120s
GRAFANA_SSO_LOG_FILE=/tmp/grafana-sso.log
GRAFANA_SSO_SCREENSHOT_DIR=/tmp/mcp-grafana-sso/screenshots
GRAFANA_SERVICE_ACCOUNT_USERNAME=your-sso-username
GRAFANA_SERVICE_ACCOUNT_PASSWORD=your-sso-password

# Use a service account token instead of browser SSO:
# GRAFANA_AUTH_MODE=token
# GRAFANA_SERVICE_ACCOUNT_TOKEN=your-service-account-token